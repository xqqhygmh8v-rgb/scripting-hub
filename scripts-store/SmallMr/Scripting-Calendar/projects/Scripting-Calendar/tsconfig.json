{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": false,
    "types": []
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "./scripting.d.ts"
  ],
  "exclude": [
    "./vendor/solarlunar.js"
  ]
}
